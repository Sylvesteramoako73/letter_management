{
  "version": 2,
  "regions": [
    "fra1"
  ],
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "schema.sql",
          "schema_postgres.sql",
          "templates/**",
          "static/**",
          "document_conversion.py"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/tasks/deadline-notices",
      "schedule": "0 6 * * *"
    }
  ]
}
